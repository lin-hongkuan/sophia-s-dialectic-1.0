# Sophia's Dialectic local environment
#
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored (see .gitignore line "*.local"); never commit a real key.

# OpenAI-compatible API key. Required to call the chat / image endpoints in dev.
# In dev/preview, Vite proxies /sophia-api and injects this header server-side, so the key
# never reaches the browser bundle. In GitHub Pages production, however, the key is baked
# into the static bundle (see DEPLOY.md "重要安全提示") — use a low-quota key for that.
SOPHIA_API_KEY=<your-openai-compatible-key>

# OpenAI-compatible base URL. The default points to the maintainer's gateway.
SOPHIA_API_BASE_URL=https://api.linhongkuan.com/v1

# Default text model used when no Settings-page override is selected.
# At runtime users can switch among presets (see SOPHIA_PRESET_*_MODEL below) or supply
# a custom model in the Settings page.
SOPHIA_API_MODEL=gpt-5.4-mini

# Image model used for thought-voice avatars. Settings page does NOT override this; change here.
SOPHIA_IMAGE_MODEL=grok-imagine-image-lite

# Provider label shown in error messages.
SOPHIA_API_PROVIDER=OpenAI-compatible

# Optional preset model names surfaced as cards on the Settings page.
# When unset, the corresponding preset card is shown as "未配置" and is not selectable.
# In CI/production these are typically set via GitHub Variables (see DEPLOY.md).
SOPHIA_PRESET_GPT_MODEL=
SOPHIA_PRESET_MIMO_MODEL=
SOPHIA_PRESET_GROK_MODEL=
